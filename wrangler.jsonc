{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jm-asesores",
  "compatibility_date": "2026-09-01",

  // Cloudflare PAGES, no Workers (17-sep-2026). Se migró para poder servir el
  // dominio sin el proxy de Cloudflare («Solo DNS») y esquivar así los bloqueos
  // de IPs de LaLiga, que dejaban la web inaccesible desde España en días de
  // partido. Un dominio de Worker exige el proxy activado; uno de Pages no.
  // Ver BITACORA.md §19.
  //
  // El sitio es estático: `npm run build` + `npm run prerender` dejan el HTML ya
  // generado en dist/client y Pages lo sirve tal cual.
  //
  // Detalles que replican el comportamiento que había en Workers:
  //   - 404 real: Pages sirve 404.html con estado 404 para rutas que no existen.
  //   - URLs sin barra final: el prerender escribe `servicios.html` (no
  //     `servicios/index.html`), así /servicios responde 200 y /servicios/
  //     redirige a ella. Con index.html Pages haría justo lo contrario.
  //   - Cabeceras y CSP: dist/client/_headers, generado por el prerender.
  "pages_build_output_dir": "./dist/client",
}
